{
  "expo": {
    "name": "UniFyd Market",
    "slug": "uninest-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "uninest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.uninestmarket.app"
    },
    "android": {
      "package": "com.uninestmarket.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "UniFyd needs access to your photos so you can add pictures to your listing."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0aa03b1-057c-4e13-be43-132ffab938a9"
      }
    },
    "owner": "eniola22"
  }
}
