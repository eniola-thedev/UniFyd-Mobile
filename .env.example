# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
PAYSTACK_SECRET_KEY="sk_test_abc123yourrealkey"
PAYSTACK_PUBLIC_KEY=