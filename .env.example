# Same Supabase project as the uni-nest-market web app.
# Find these in your Supabase project settings -> API,
# or reuse the values from the web app's .env file.
EXPO_PUBLIC_SUPABASE_URL=https://your-real-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-real-key
